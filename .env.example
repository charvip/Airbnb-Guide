# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Password for the host editor at /host (required to use the host side).
HOST_PASSWORD=choose-a-strong-host-password

# Passcode guests enter to see Essentials (door code, WiFi). Optional.
GUEST_CODE=choose-a-passcode-for-guests

# Added automatically by Vercel when you connect a Blob store.
# For local dev, copy it from Vercel → Storage → your Blob store.
BLOB_READ_WRITE_TOKEN=
